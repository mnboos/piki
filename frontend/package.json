{
  "name": "piki-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "api:generate:schema": "cd ../src && uv run manage.py export_openapi_schema --indent 4 --output api.json",
    "api:generate:client": "openapi-generator-cli generate -g typescript-fetch -o src/api -i ../src/api.json",
    "api:update": "npm run api:generate:schema && npm run api:generate:client"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.85.5",
    "vue": "3.5.20",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.24.0",
    "@tsconfig/node22": "22.0.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.18.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/eslint-plugin": "1.3.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.34.0",
    "eslint-plugin-vue": "10.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "7.1.5",
    "vite-plugin-vue-devtools": "8.0.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.0.6"
  },
  "prettier": {
    "tabWidth": 4,
    "singleQuote": false,
    "printWidth": 120,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore"
  }
}
