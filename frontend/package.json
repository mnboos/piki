{
  "name": "piki-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "api:generate:schema": "cd ../src && uv run manage.py export_openapi_schema --indent 4 --output api.json",
    "api:generate:client": "openapi-generator-cli generate -g typescript-fetch -o src/api -i ../src/api.json",
    "api:update": "npm run api:generate:schema && npm run api:generate:client"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/icons": "^4.5.5",
    "@primevue/themes": "^4.5.4",
    "@tanstack/vue-query": "5.99.0",
    "primevue": "4.5.5",
    "vue": "3.5.32",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.31.1",
    "@tsconfig/node22": "22.0.5",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.6.0",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/eslint-plugin": "1.6.16",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.2.0",
    "eslint-plugin-vue": "10.8.0",
    "jsdom": "29.0.2",
    "prettier": "3.8.3",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vite-plugin-vue-devtools": "8.1.1",
    "vitest": "3.2.4",
    "vue-tsc": "3.2.6"
  },
  "prettier": {
    "tabWidth": 4,
    "singleQuote": false,
    "printWidth": 120,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "htmlWhitespaceSensitivity": "ignore"
  }
}
