[Unit]
Description=piki robot backend (daphne + mipi_cam)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/src/piki
Environment=PIKI_PROD=1
ExecStart=/home/sunrise/src/piki/run.sh
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
